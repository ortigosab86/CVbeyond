      color: var(--text-secondary);
      margin-bottom: 1rem;
    }

    .tag-cloud {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .tag {
      background: rgba(37, 99, 235, 0.14);
      border: 1px solid rgba(56, 189, 248, 0.25);
      color: #E0F2FE;
      font-size: 0.78rem;
      font-weight: 500;
      padding: 0.3rem 0.65rem;
      border-radius: 6px;
    }

    /* Experience Timeline */
    .timeline {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .exp-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-left: 3px solid var(--accent-blue);
      border-radius: 12px;
      padding: 1.75rem 2rem;
    }

    .exp-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 0.85rem;
    }

    .exp-role {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-primary);
    }

    .exp-company {
      color: var(--accent-cyan);
      font-weight: 600;
      font-size: 0.95rem;
    }

    .exp-date {
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-secondary);
      background: rgba(15, 23, 42, 0.7);
      padding: 0.3rem 0.75rem;
      border-radius: 20px;
      border: 1px solid var(--border-subtle);
    }

    .exp-bullets {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .exp-bullets li {
      position: relative;
      padding-left: 1.25rem;
      font-size: 0.93rem;
      color: var(--text-secondary);
    }

    .exp-bullets li::before {
      content: "▹";
      position: absolute;
      left: 0;
      color: var(--accent-cyan);
      font-weight: 700;
    }

    /* Education & Credentials */
    .edu-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .edu-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 1.4rem 1.6rem;
    }

    .edu-card h4 {
      font-size: 1rem;
      color: var(--text-primary);
      margin-bottom: 0.25rem;
    }

    .edu-card p {
      font-size: 0.88rem;
      color: var(--text-secondary);
    }

    /* Footer CTA */
    .footer-cta {
      margin-top: 2rem;
      padding: 4rem 0;
      background: linear-gradient(180deg, rgba(17, 24, 39, 0.4) 0%, rgba(11, 17, 32, 1) 100%);
      border-top: 1px solid var(--border-subtle);
      text-align: center;
    }

    .footer-cta h2 {
      font-size: 2rem;
      margin-bottom: 0.85rem;
    }

    .footer-cta p {
      color: var(--text-secondary);
      max-width: 580px;
      margin: 0 auto 2rem;
    }

    .footer-links {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 3rem;
    }

    .copyright {
      font-size: 0.82rem;
      color: var(--text-muted);
      letter-spacing: 0.06em;
    }

    @media (max-width: 900px) {
      .hero-grid { grid-template-columns: 1fr; }
      .metrics-grid { grid-template-columns: repeat(2, 1fr); }
      .pillars-grid { grid-template-columns: 1fr; }
      .edu-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 520px) {
      .metrics-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
